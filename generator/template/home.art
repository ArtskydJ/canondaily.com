<div class="container">
	<a class="home-today-btn" href="">Today</a>

	<div class="home-progress">
		<ul class="home-progress-list" id="progress-list" style="display:none"></ul>
	</div>

	<div class="home-stat" id="behind-status">—</div>

	<div class="home-links">
		<a href="/calendar">Calendar</a>
		<a href="/bulk-edit">Bulk Edit</a>
		<a href="https://github.com/ArtskydJ/canondaily.com">Github</a>
	</div>
</div>

<script>
	var monthNames = {{@ monthNamesJson }}
	var expectedMonthLength = {{@ expectedMonthLengthJson }}

	// Reading day-of-year always treats February as 28 days (no Feb 29 reading exists).
	function readingDayOfYear(month, day) {
		var total = Math.min(day, expectedMonthLength[month])
		for (var m = 1; m < month; m++) total += expectedMonthLength[m]
		return total
	}

	function buildDayList() {
		var days = []
		for (var m = 1; m <= 12; m++) {
			for (var d = 1; d <= expectedMonthLength[m]; d++) {
				days.push({ month: m, day: d })
			}
		}
		return days
	}

	function readMonthData() {
		var data = {}
		for (var m = 1; m <= 12; m++) {
			var json = localStorage.getItem(m)
			data[m] = json ? JSON.parse(json) : []
		}
		return data
	}

	// Chronological runs of same-completion days, e.g. [ completed Jan 1, missed Jan 2, completed Jan 3 ].
	// Stops at today, or at the last completed day if reading ahead.
	function getRuns(days, monthData, todayDoy) {
		var lastCompleted = 0
		for (var i = 0; i < days.length; i++) {
			if (monthData[days[i].month][days[i].day] === 1) lastCompleted = i + 1
		}
		var end = Math.max(todayDoy, lastCompleted)

		var runs = []
		var current = null
		for (var j = 0; j < end; j++) {
			var d = days[j]
			var done = monthData[d.month][d.day] === 1
			if (current && current.completed === done) {
				current.days.push(d)
			} else {
				current = { completed: done, days: [ d ] }
				runs.push(current)
			}
		}
		return runs
	}

	function plural(n) {
		return n === 1 ? 'day' : 'days'
	}

	function suffix(month, day, todayMonth, todayDay, yMonth, yDay) {
		if (month === todayMonth && day === todayDay) return ' (Today)'
		if (month === yMonth && day === yDay) return ' (Yesterday)'
		return ''
	}

	function dayLabel(month, day, todayMonth, todayDay, yMonth, yDay) {
		return monthNames[month] + ' ' + day + suffix(month, day, todayMonth, todayDay, yMonth, yDay)
	}

	function rangeText(runDays, todayMonth, todayDay, yMonth, yDay) {
		var start = runDays[0]
		var end = runDays[runDays.length - 1]
		var endLabel = dayLabel(end.month, end.day, todayMonth, todayDay, yMonth, yDay)
		if (start === end) return endLabel + ' ✓'
		return monthNames[start.month] + ' ' + start.day + ' - ' + endLabel + ' ✓'
	}

	// Long runs of missed days are collapsed to first two, ellipsis, last two.
	function collapse(list) {
		if (list.length < 6) return list
		return [ list[0], list[1], { hidden: list.length - 4 }, list[list.length - 2], list[list.length - 1] ]
	}

	function escapeHtml(s) {
		return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
	}

	function updatePage() {
		var now = new Date()
		var todayMonth = now.getMonth() + 1
		var todayDay = now.getDate()

		var yest = new Date()
		yest.setDate(yest.getDate() - 1)
		var yMonth = yest.getMonth() + 1
		var yDay = yest.getDate()

		var btnDay = todayDay
		if (todayMonth === 2 && btnDay === 29) btnDay = 28
		document.querySelector('a.home-today-btn').href = '/' + monthNames[todayMonth] + '/' + btnDay

		var days = buildDayList()
		var monthData = readMonthData()
		var todayDoy = readingDayOfYear(todayMonth, todayDay)
		var runs = getRuns(days, monthData, todayDoy)

		var progressList = document.getElementById('progress-list')
		if (runs.length === 0) {
			progressList.style.display = 'none'
		} else {
			progressList.style.display = ''
			progressList.innerHTML = runs.map(function (run) {
				if (run.completed) {
					return '<li>' + escapeHtml(rangeText(run.days, todayMonth, todayDay, yMonth, yDay)) + '</li>'
				}
				return collapse(run.days).map(function (u) {
					if (u.hidden) return '<li class="home-progress-ellipsis">' + u.hidden + ' more …</li>'
					var href = '/' + monthNames[u.month] + '/' + u.day
					var label = dayLabel(u.month, u.day, todayMonth, todayDay, yMonth, yDay)
					return '<li><a href="' + escapeHtml(href) + '">' + escapeHtml(label) + '</a></li>'
				}).join('')
			}).join('')
		}

		var completedCount = 0
		for (var i = 0; i < days.length; i++) {
			if (monthData[days[i].month][days[i].day] === 1) completedCount++
		}
		var diff = completedCount - todayDoy
		var statusEl = document.getElementById('behind-status')
		if (diff > 0) statusEl.textContent = diff + ' ' + plural(diff) + ' ahead'
		else if (diff < 0) statusEl.textContent = -diff + ' ' + plural(-diff) + ' behind'
		else statusEl.textContent = 'Caught up'
	}

	updatePage()
	setInterval(updatePage, 1000)
</script>
